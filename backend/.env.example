# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated list for preview/custom domains.
CLIENT_URLS=

# Database and auth
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Optional email provider (welcome emails are skipped if omitted)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Chatify

# Optional image upload provider (image uploads return 503 if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Arcjet protection (disabled if omitted)
ARCJET_KEY=
ARCJET_ENV=development
