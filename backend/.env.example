# Required for every environment.
# Use MongoDB Atlas from the start; do not use a local MongoDB URL for deployment.
MONGO_URI=mongodb+srv://<atlas-user>:<atlas-password>@<atlas-cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>

# Optional runtime settings. Defaults are safe for the no-domain AWS EC2 guide.
PORT=3000
NODE_ENV=production

# Optional CORS lock-down.
# Leave these blank for the first no-domain EC2 deployment, where the frontend and
# backend are served from the same EC2 public DNS/IP through Nginx.
# Set CLIENT_URL later when you add a custom domain or split frontend/backend hosts.
CLIENT_URL=
CLIENT_URLS=

# Optional email provider. Leave blank to skip welcome emails.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Chatify

# Optional image uploads. Leave blank if you do not need image/profile uploads yet.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional abuse/rate protection. Leave blank to disable Arcjet middleware.
ARCJET_KEY=
ARCJET_ENV=production
